    "idtype={{ idtype }};head_dim_qk={{ head_dim_qk }};head_dim_vo={{ head_dim_vo }};"
    "posenc={{ pos_encoding_mode }};swa={{ use_sliding_window }};logits_cap={{ use_logits_soft_cap }};"
