                  std::is_same_v<DTypeV, __nv_fp4x2_e2m1>,
              "NVFP4 KV paged prefill must build at least one packed FP4 K/V container type");
{% endif %}
constexpr int HEAD_DIM_QK = {{ head_dim_qk }};
constexpr int HEAD_DIM_VO = {{ head_dim_vo }};
constexpr bool USE_FP16_QK_REDUCTION = {{ use_fp16_qk_reduction }};
constexpr auto USE_LOGITS_SOFT_CAP = {{ use_logits_soft_cap }};
constexpr auto POS_ENCODING_MODE = {{ pos_encoding_mode }};
constexpr auto USE_SLIDING_WINDOW = {{ use_sliding_window }};
constexpr bool REQUIRE_FP4_KV_CACHE = {{ "true" if require_fp4_kv_cache else "false" }};
constexpr const char* JIT_DTYPE_Q_NAME = "{{ dtype_q }}";
constexpr const char* JIT_DTYPE_KV_NAME = "{{ dtype_kv }}";
constexpr const char* JIT_DTYPE_K_NAME = "{{ dtype_k }}";
constexpr const char* JIT_DTYPE_V_NAME = "{{ dtype_v }}";
constexpr const char* JIT_DTYPE_O_NAME = "{{ dtype_o }}";
constexpr const char* JIT_IDTYPE_NAME = "{{ idtype }}";
constexpr const char* JIT_ADDITIONAL_TENSOR_NAMES = "{{ additional_tensor_names | join(',') }}";
constexpr const char* JIT_ADDITIONAL_TENSOR_DTYPES = "{{ additional_tensor_dtypes | join(',') }}";
constexpr const char* JIT_ADDITIONAL_SCALAR_NAMES = "{{ additional_scalar_names | join(',') }}";
constexpr const char* JIT_ADDITIONAL_SCALAR_DTYPES = "{{ additional_scalar_dtypes | join(',') }}";
constexpr const char* JIT_MODULE_URI = "{{ uri }}";
